{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The main window: timer test controls, settings, minimize and quit.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "allow-get-state",
    "allow-report-shown",
    "allow-add-timer",
    "allow-remove-timer",
    "allow-expire-all",
    "allow-quit-app",
    "allow-get-settings",
    "allow-set-wait-minutes",
    "allow-set-autostart"
  ]
}
