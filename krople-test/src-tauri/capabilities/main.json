{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The main window: patient cards, settings, minimize and quit.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "allow-get-state",
    "allow-add-patient",
    "allow-mark-drop",
    "allow-remove-patient",
    "allow-quit-app",
    "allow-get-settings",
    "allow-set-interval-minutes",
    "allow-set-wait-minutes",
    "allow-set-autostart"
  ]
}
