{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Krople Test",
  "version": "0.1.0",
  "identifier": "pl.krople.test",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Krople",
        "url": "index.html",
        "width": 960,
        "height": 680,
        "minWidth": 480,
        "minHeight": 360,
        "center": true
      },
      {
        "label": "icon",
        "title": "Krople – ikona",
        "url": "icon.html",
        "width": 72,
        "height": 72,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
